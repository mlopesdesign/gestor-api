{
    "name": "mlopesdesign/gestor-api",
    "description": "API REST central do Gestor Inteligente de Demandas.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "wp-phpunit/wp-phpunit": "^6.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Gestor_Api\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-setup": "wp scaffold plugin-tests gestor-api"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
